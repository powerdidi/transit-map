function drawMap() {
  const canvas = $('#mapCanvas');
  if(!canvas) return;

  let stations = [];
  let routes = [];
  let targetView = {x:0, y:0, w:100, h:100};

  if (S.overview.lines.length > 0) {
      let allStopsSet = new Set();
      S.overview.lines.forEach(lid => {
          const L = LINES[lid];
          const pts = L.stops.map(sid => ({ sid, x: ST[sid].x, y: ST[sid].y }));
          routes.push({ color: L.color, points: pts });
          L.stops.forEach(sid => allStopsSet.add(sid));
      });
      stations = [...allStopsSet].map(sid => ({ sid, ...ST[sid] }));
      
      if (stations.length > 0) {
          let minX = 100, minY = 100, maxX = 0, maxY = 0;
          stations.forEach(p => {
              minX = Math.min(minX, p.x);
              minY = Math.min(minY, p.y);
              maxX = Math.max(maxX, p.x);
              maxY = Math.max(maxY, p.y);
          });
          const pad = 15;
          minX = Math.max(0, minX - pad);
          minY = Math.max(0, minY - pad);
          maxX = Math.min(100, maxX + pad);
          maxY = Math.min(100, maxY + pad);
          let w = maxX - minX;
          let h = maxY - minY;
          
          const canvasRatio = canvas.clientWidth / canvas.clientHeight;
          if (w / h > canvasRatio) { 
              const newH = w / canvasRatio;
              const diff = (newH - h) / 2;
              minY -= diff; maxY += diff;
              h = newH;
          } else {
              const newW = h * canvasRatio;
              const diff = (newW - w) / 2;
              minX -= diff; maxX += diff;
              w = newW;
          }
          targetView = {x:minX, y:minY, w:w, h:h};
      }
  } else if (S.overview.mode) {
      stations = Object.keys(ST).filter(sid => {
          const st = ST[sid];
          if (S.overview.mode === 'bike') return st.dock;
          return st.lines.some(l => LINES[l].type === S.overview.mode);
      }).map(sid => ({ sid, ...ST[sid] }));
  }

  const modeColor = S.overview.mode === 'bus' ? '#4f9159' :
                    S.overview.mode === 'metro' ? '#b08b25' :
                    S.overview.mode === 'brt' ? '#c14f4b' :
                    S.overview.mode === 'bike' ? '#8a63a8' : '#ccc';

  let routesHtml = routes.map(r => {
      let path = `M ${r.points[0].x} ${r.points[0].y} `;
      for(let i=1; i<r.points.length; i++) path += `L ${r.points[i].x} ${r.points[i].y} `;
      return `<path d="${path}" fill="none" stroke="${r.color}" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity="0.8" />`;
  }).join('');

  canvas.innerHTML = `
    <svg class="map-svg" viewBox="${mapCurrentView.x} ${mapCurrentView.y} ${mapCurrentView.w} ${mapCurrentView.h}" preserveAspectRatio="xMidYMid slice">
      <rect width="100" height="100" fill="#e6e9ef" />
      <path d="M 0 50 C 20 40, 40 60, 50 50 C 60 40, 80 60, 100 50 L 100 60 C 80 70, 60 50, 50 60 C 40 70, 20 50, 0 60 Z" fill="#d6e0ef" opacity="0.6" />
      <path d="M 10 10 L 30 5 L 35 25 L 15 30 Z" fill="#d4e8d6" opacity="0.6" />
      <path d="M 60 60 L 90 65 L 85 85 L 55 80 Z" fill="#d4e8d6" opacity="0.6" />
      <path d="M 0 20 L 100 25" stroke="#ffffff" stroke-width="1.5" opacity="0.8" />
      <path d="M 0 70 L 100 75" stroke="#ffffff" stroke-width="1.5" opacity="0.8" />
      <path d="M 20 0 L 25 100" stroke="#ffffff" stroke-width="1.5" opacity="0.8" />
      <path d="M 70 0 L 75 100" stroke="#ffffff" stroke-width="1.5" opacity="0.8" />

      ${routesHtml}

      ${stations.map(st => `
        <g class="map-station" data-sid="${st.sid}" transform="translate(${st.x}, ${st.y})">
          <circle r="${routes.length ? 1.2 : 1}" fill="#e6e9ef" stroke="${modeColor}" stroke-width="0.6" />
        </g>
      `).join('')}
    </svg>
  `;
  
  animateMapZoom(targetView);
}

function bindOverview() {
  document.querySelectorAll('.map-mode').forEach(btn => {
    btn.onclick = () => {
      const mode = btn.dataset.mode;
      if (S.overview.mode === mode) {
        S.overview.mode = null; 
      } else {
        S.overview.mode = mode;
      }
      S.overview.lines = []; 
      renderOverview();
    };
