        b.origin=el.dataset.sid;b.step=2;toast(`مبدا ثبت شد: ${ST[b.origin].n}`,'map-pin');renderBus();});
      const lon=$('#locOnBtn');if(lon)lon.onclick=()=>{b.loc=true;toast('لوکیشن روشن شد','locate-fixed');renderBus();};
    };
    draw('');if(inp)inp.oninput=e=>draw(e.target.value.trim());
  }
  if(b.step===4){
    scr.querySelectorAll('.hit').forEach(c=>c.onclick=()=>stationSheet(c.dataset.sid));
    const rp=scr.querySelector('.rp');
    if(rp){
      const len=rp.getTotalLength();
      rp.style.strokeDasharray=len;rp.style.strokeDashoffset=len;
      requestAnimationFrame(()=>{rp.style.transition='stroke-dashoffset 1.5s cubic-bezier(.55,.1,.3,1) .15s';rp.style.strokeDashoffset=0;});
    }
    const svg=$('#rsvg'),mk=svg.querySelector('#busM'),plen=rp.getTotalLength();
    const sts=[...svg.querySelectorAll('.st')].map(g=>{
      const c=g.querySelector('.pc');let best=0,bd=1e9;
      for(let i=0;i<=240;i++){const p=rp.getPointAtLength(plen*i/240);
        const dd=(p.x-c.cx.baseVal.value)**2+(p.y-c.cy.baseVal.value)**2;
        if(dd<bd){bd=dd;best=plen*i/240;} }
      return {g,len:best,sid:g.querySelector('.hit').dataset.sid}; // fixed typo
    }).sort((a,b)=>a.len-b.len);
    
    const place=d=>{const p=rp.getPointAtLength(d);mk.setAttribute('transform',`translate(${p.x},${p.y})`);};
    
    $('#playBtn').onclick=()=>{
      const pb=$('#playBtn');
      const isHidden = mk.style.opacity === '0' || mk.style.opacity === '';
      if(isHidden){
        const targetLen = sts.length > 1 ? (sts[0].len + sts[1].len) / 2 : plen / 2;
        place(targetLen);
        mk.style.opacity=1;
        pb.innerHTML='<i data-lucide="eye-off"></i> مخفی کردن اتوبوس';
      } else {
        mk.style.opacity=0;
        pb.innerHTML='<i data-lucide="bus"></i> نمایش اتوبوس در مسیر';
      }
      icons();
    };
  }
}

