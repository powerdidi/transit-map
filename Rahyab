/* ================= قطعات مشترک ================= */
function lineChip(lid,lg=false){const L=LINES[lid];return `<span class="lchip ${lg?'lg':''}" style="--c:${L.color}">${fa(L.num)}</span>`;}
function lineNumsStr(sid){
  const seen=new Set();ST[sid].lines.forEach(l=>seen.add(+LINES[l].num));
  return [...seen].sort((a,b)=>a-b).map(v=>fa(v)).join(' - ');
}
function stListHTML(q){
  let ids=Object.keys(ST);
  if(q)ids=ids.filter(s=>ST[s].n.includes(q)||String(ST[s].c).includes(q));
  else ids=['shohada','azadi','haram','ferdowsi','siyad','kaveh'];
  if(!ids.length)return `<p class="qr-hint">ایستگاهی با این نام یا کد پیدا نشد</p>`;
  return `<div class="sres">${ids.map(sid=>{const st=ST[sid];return `
    <button class="sres-row" data-sid="${sid}">
      <i data-lucide="map-pin"></i>
      <span class="sres-tx"><b>${st.n} <span>(کد ${fa(st.c)})</span></b><span>خطوط عبوری: ${lineNumsStr(sid)}</span></span>
      <span class="sres-b">${st.dock?'<span class="mb"><i data-lucide="bike"></i>دوک</span>':''}</span>
    </button>`}).join('')}</div>`;
}
function depBoard(sid){
  const st=ST[sid];
  const rows=st.lines.map(lid=>{
    const L=LINES[lid],idx=L.stops.indexOf(sid),t=nextDeps(lid,idx,1);
    let timeText = 'پایان سرویس';
    if (t && t[0]) {
        const now = new Date();
        const curMin = now.getHours()*60 + now.getMinutes();
        const diff = Math.max(0, t[0] - curMin);
        if (diff === 0) timeText = 'در حال حرکت';
        else timeText = `~${fa(diff)} دقیقه`;
    }
    return `<div class="dep">
              ${lineChip(lid)}
              <div class="dep-mid">
                <b>${L.title}</b>
                <span>به سمت ${L.to}</span>
              </div>
              <div class="dep-t"><b>${timeText}</b></div>
            </div>`;}).join('');
  return `<div class="board">${rows}</div>`;
}
