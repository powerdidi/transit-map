const NOTICES=[
 'خط ۱۱۰ از شنبه با سرفاصله ۱۵ دقیقه در ساعات اوج حرکت می‌کند.',
 'دوک دوچرخه میدان شهدا با ۳۰ دوچرخه جدید تکمیل شد.',
 'BRT خط ۲: توقف موقت در ضلع میدان فردوسی به دلیل بازسازی بزرگراه.'
];
const dist2=(a,b)=>Math.hypot(ST[a].x-ST[b].x,ST[a].y-ST[b].y);

/* ================= زمانبندی شبیه‌سازی‌شده ================= */
function lineSeed(id){let s=0;for(const c of id)s+=c.charCodeAt(0);return s;}
const SVC0=330,SVC1=1330; /* ۵:۳۰ تا ۲۲:۱۰ */
function nextDeps(lid,idx,count=3){
  const L=LINES[lid],hw=L.hw;
  const now=new Date(),cur=now.getHours()*60+now.getMinutes();
  const off=(idx*3+lineSeed(lid))%hw;
  if(cur>=SVC1)return null;
  let base=cur<SVC0?SVC0+off:cur+((off-cur%hw)+hw)%hw;
  if(cur>=SVC0&&base-cur<2)base+=hw;
  const out=[];for(let i=0;i<count&&base+i*hw<SVC1;i++)out.push(base+i*hw);
  return out;
}

