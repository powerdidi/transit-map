function runPlanner(){
  const c=S.combo;
  c.loading=true;c.results=null;renderCombo();
  setTimeout(()=>{
    const strats=[
      {key:'fast', label:'سریع‌ترین', cl:'#35805a'},
      {key:'cheap', label:'اقتصادی‌ترین', cl:'#c98a35'}
    ];
    const seen=new Set();c.results=[];
    for(const s of strats){
      const r=planTrip(c.from,c.to,c.modes,s.key);
      if(!r) continue;
      const key=r.legs.map(l=>l.kind+(l.line||'')+l.from+l.to).join('>');
      if(seen.has(key)) continue; seen.add(key);
      r.label=s.label; r.bcl=s.cl;
      c.results.push(r);
      if(c.results.length === 2) break;
    }
    c.active=0;c.loading=false;
    if(!c.results.length){toast('با سرویس‌های انتخابی مسیری پیدا نشد — حداقل یک سرویس را فعال کنید','info');renderCombo();return;}
    renderCombo();
  },800);
}
function comboResults(){
  const c=S.combo;
  const strip=r=>`<span class="opt-strip">${r.legs.map(l=>{
    const w=Math.max(10,Math.round(l.mins/r.total*100));
    const col=l.kind==='ride'?LINES[l.line].color:l.kind==='bike'?'#4f9159':'#98a89b';
    const ic=l.kind==='ride'?typeIc[LINES[l.line].type]:typeIc[l.kind==='bike'?'bike':'walk'];
    return`<span class="seg" style="background:${col};width:${w}%"><i data-lucide="${ic}"></i></span>`;}).join('')}</span>`;
  const tlItem=(ic,col,b,sub,wt='')=>`<div class="tl-i">
    <span class="tl-ic" ${col?`style="color:${col}"`:''}><i data-lucide="${ic}"></i></span>
    <div class="tl-tx"><b>${b}</b>${sub?`<span>${sub}</span>`:''}${wt}</div></div>`;
  const timeline=r=>`<div class="opt-bd"><div class="tl">${r.legs.map((l,i)=>{
    let h='';
    if(i>0&&l.kind==='ride'&&r.legs[i-1].kind==='ride'){
      const L2=LINES[l.line];
      h+=tlItem('repeat','#c98a35',`در «${ST[r.legs[i-1].to].n}» به ${L2.title} منتقل شو`,'');
    }
    if(l.kind==='walk')h+=tlItem('footprints','',`${fa(Math.round(l.mins))} دقیقه پیاده تا «${ST[l.to].n}»`,'');
    else if(l.kind==='bike')h+=tlItem('bike','#4f9159',`دوچرخه بگیر و تا «${ST[l.to].n}» رکاب بزن`,`از دوک ${ST[l.from].n} · ~${fa(Math.round(l.mins))} دقیقه`);
    else if(l.kind==='ride'){const L=LINES[l.line],idx=L.stops.indexOf(l.from),nx=nextDeps(l.line,idx,1);
      h+=tlItem(typeIc[L.type],L.color,`${L.type==='brt'?'سوار BRT شو':'سوار '+L.title+' شو'}`,
        `به سمت ${L.to} · ${ST[l.from].n} → ${ST[l.to].n}<br>${fa(l.stops)} ایستگاه · ~${fa(Math.round(l.wait+l.mins))} دقیقه`,
        nx?`<span class="wt"><i data-lucide="clock"></i>سرویس بعدی: ${faTime(nx[0])} · انتظار ~${fa(l.wait)} دقیقه</span>`:'');}
    return h;}).join('')}
    ${tlItem('flag','#35805a',`به «${ST[c.to].n}» رسیدی`,'پیاده نهایی ~۳ دقیقه')}</div></div>`;
  return `${c.results.map((r,i)=>`<div class="opt">
      <button class="opt-h" data-opt="${i}">
        <span class="opt-b" style="background:${r.bcl}">${r.label}</span>
        <i data-lucide="chevron-down" class="opt-chev ${c.active===i?'rot':''}"></i>
      </button>
      <div style="padding:0 16px">${strip(r)}
        <div class="opt-m"><b>${fa(Math.round(r.total))} دقیقه</b>
          <span>${faMoney(r.fare)} تومان${r.legs.filter(l=>l.kind==='ride').length>1?' · بلیت ترکیبی ۲۰٪ تخفیف':''}</span></div>
      </div>
      ${c.active===i?timeline(r):''}
    </div>`).join('')}`;
}

