            const toggle = row.querySelector('.sheet-toggle');
            toggle.classList.toggle('on');
            
            if (S.overview.lines.includes(lid)) {
                S.overview.lines = S.overview.lines.filter(id => id !== lid);
            } else {
                S.overview.lines.push(lid);
            }
            
            renderOverview(); 
        };
    });

    $('#closeLineSheet').onclick = closeSheet;
}

/* ================= رویدادهای سراسری ================= */
 $('#screen').addEventListener('click',e=>{
  const g=e.target.closest('[data-go]');if(g){go(g.dataset.go);return;}
  const o=e.target.closest('[data-opt]');
  if(o){S.combo.active=+o.dataset.opt===S.combo.active?-1:+o.dataset.opt;renderCombo();return;}
});
document.querySelectorAll('#dock button').forEach(b=>b.onclick=()=>go(b.dataset.dock));

/* ================= ساعت و تاریخ ================= */
function clockTick(){
  const d=new Date();
  const cEl=$('#clock');
  if(cEl) cEl.textContent = fa(String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'));
  const dEl=$('#date');
  if(dEl) {
    try {
      const dateStr = new Intl.DateTimeFormat('fa-IR', { day: 'numeric', month: 'long' }).format(d);
      dEl.textContent = dateStr; 
    } catch(e) {
      dEl.textContent = '';
    }
  }
}
setInterval(clockTick, 1000);

/* ================= شروع ================= */
renderHome();icons();
</script>
