let mapAnimRaf = null;
let mapCurrentView = {x:0, y:0, w:100, h:100};

function animateMapZoom(target) {
    if (mapAnimRaf) cancelAnimationFrame(mapAnimRaf);
    
    const step = () => {
        const easing = 0.12;
        mapCurrentView.x += (target.x - mapCurrentView.x) * easing;
        mapCurrentView.y += (target.y - mapCurrentView.y) * easing;
        mapCurrentView.w += (target.w - mapCurrentView.w) * easing;
        mapCurrentView.h += (target.h - mapCurrentView.h) * easing;
        
        const svg = document.querySelector('.map-svg');
        if (svg) {
            svg.setAttribute('viewBox', `${mapCurrentView.x} ${mapCurrentView.y} ${mapCurrentView.w} ${mapCurrentView.h}`);
        }
        
        if (Math.abs(target.x - mapCurrentView.x) > 0.01 || Math.abs(target.w - mapCurrentView.w) > 0.01) {
            mapAnimRaf = requestAnimationFrame(step);
        } else {
            mapCurrentView = {...target};
            if (svg) svg.setAttribute('viewBox', `${mapCurrentView.x} ${mapCurrentView.y} ${mapCurrentView.w} ${mapCurrentView.h}`);
            mapAnimRaf = null;
        }
    };
    
    step();
}

