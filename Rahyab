 L110:{id:'L110',type:'bus',num:'110',title:'اتوبوس خط ۱۱۰',color:'#8a63a8',hw:18,from:'حرم مطهر',to:'شهرک رازی',stops:['haram','shohada','kaveh','koohsangi','razi']},
 L55:{id:'L55',type:'bus',num:'55',title:'اتوبوس خط ۵۵',color:'#c05a78',hw:20,from:'بلوار سجاد',to:'میدان داد',stops:['sajjad','ariya','azadi','ghasemabad','dad']},
 M1:{id:'M1',type:'metro',num:'1',title:'مترو خط ۱',color:'#b08b25',hw:6,from:'بلوار وکیل‌آباد',to:'بزرگراه توس',stops:['vakilabad','parkemellat','azadi','ariya','ahmadabad','malekabad','siyad','toos']},
 M2:{id:'M2',type:'metro',num:'2',title:'مترو خط ۲',color:'#4b6b9e',hw:7,from:'میدان مدینه‌الرضا',to:'میدان آزادی',stops:['medinerreza','tabarsi','haram','kaveh','koohsangi','dad','ghasemabad','azadi']},
