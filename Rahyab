function qrSVG(code){
  const N=21,cell=7,m=Array.from({length:N},()=>Array(N).fill(0));
  const rnd=mulberry32(code*7+13);
  const fin=(r,c)=>{for(let i=0;i<7;i++)for(let j=0;j<7;j++)m[r+i][c+j]=(i===0||i===6||j===0||j===6||(i>1&&i<5&&j>1&&j<5))?1:0;};
  fin(0,0);fin(0,N-7);fin(N-7,0);
  for(let i=8;i<N-8;i++){m[6][i]=i%2?0:1;m[i][6]=i%2?0:1;}
  for(let r=0;r<N;r++)for(let c=0;c<N;c++){
    if((r<8&&c<8)||(r<8&&c>=N-8)||(r>=N-8&&c<8))continue;
    if(r===6||c===6)continue;
    m[r][c]=rnd()>.52?1:0;
  }
  let s=`<svg viewBox="0 0 ${N*cell} ${N*cell}" xmlns="http://www.w3.org/2000/svg"><rect width="100%" height="100%" fill="#e6e9ef"/>`;
  for(let r=0;r<N;r++)for(let c=0;c<N;c++)if(m[r][c])s+=`<rect x="${c*cell}" y="${r*cell}" width="${cell-1}" height="${cell-1}" rx="1.5" fill="#37453b"/>`;
  return s+'</svg>';
}

/* ================= موتور مسیریابی ترکیبی (دایکسترا) ================= */
function planTrip(fromId,toId,modes,strat){
  const P={
    fast :{wait:{bus:6,brt:4,metro:5}, ride:{bus:2.6,brt:2.2,metro:1.9}, walkF:.9,  bikeF:9,  bikeC:1.5},
    cheap:{wait:{bus:5,brt:5,metro:10},ride:{bus:2.4,brt:2.4,metro:2.0}, walkF:.9,  bikeF:9,  bikeC:1.5},
    green:{wait:{bus:8,brt:6,metro:4}, ride:{bus:3.0,brt:2.6,metro:1.8}, walkF:.75, bikeF:12, bikeC:1.2},
  }[strat];
  const start=fromId+'@src',dmap=new Map([[start,0]]),prev=new Map(),done=new Set(),pq=[[0,start]];
  function relax(nk,cost,act,pk){
    const cur=dmap.get(nk);
    if(cur==null||cost<cur){dmap.set(nk,cost);prev.set(nk,{act,pk});pq.push([cost,nk]);}
  }
  while(pq.length){
    pq.sort((a,b)=>a[0]-b[0]);
    const [d,k]=pq.shift();
    if(done.has(k))continue;done.add(k);
    const [sid,ctx]=k.split('@');
    if(ctx==='src'){
      for(const lid of ST[sid].lines){const L=LINES[lid];if(!modes[L.type])continue;
        relax(sid+'@'+lid,d+P.wait[L.type],{a:'board',line:lid,wait:P.wait[L.type]},k);}
      for(const o in ST){if(o===sid)continue;const dd=dist2(sid,o);
        if(dd<=9)relax(o+'@src',d+dd*P.walkF+.4,{a:'walk',from:sid,to:o,mins:dd*P.walkF+.4},k);}
      if(modes.bike&&ST[sid].dock)for(const o in ST){
        if(o===sid||!ST[o].dock)continue;const dd=dist2(sid,o);
        if(dd>6&&dd<=45)relax(o+'@src',d+P.bikeC+dd/P.bikeF,{a:'bike',from:sid,to:o,mins:P.bikeC+dd/P.bikeF},k);}
    }else{
      const L=LINES[ctx],idx=L.stops.indexOf(sid);
      for(const j of[idx-1,idx+1]){if(j<0||j>=L.stops.length)continue;
        relax(L.stops[j]+'@'+ctx,d+P.ride[L.type],{a:'ride',line:ctx},k);}
      relax(sid+'@src',d+1,{a:'alight'},k);
    }
  }
  if(!dmap.has(toId+'@src'))return null;
  const total=dmap.get(toId+'@src')+3;
  const steps=[];let k=toId+'@src';
  while(k&&k!==start){const p=prev.get(k);if(!p)break;steps.unshift({node:k,act:p.act,cost:p.cost});k=p.pk;}
  const legs=[];let cur=null;
  for(const s of steps){
    const a=s.act,[sid]=s.node.split('@');
    if(a.a==='board'){if(cur)legs.push(cur);cur={kind:'ride',line:a.line,from:sid,to:sid,stops:0,mins:0,wait:a.wait};}
    else if(a.a==='ride'){if(!cur)cur={kind:'ride',line:a.line,from:sid,to:sid,stops:0,mins:0,wait:0};cur.stops++;cur.mins+=s.cost;cur.to=sid;}
    else if(a.a==='alight'){if(cur){legs.push(cur);cur=null;}}
    else{if(cur){legs.push(cur);cur=null;}legs.push({kind:a.a,from:a.from,to:a.to,mins:a.mins});}
  }
  if(cur)legs.push(cur);
  let fare=legs.reduce((s,l)=>s+(l.kind==='ride'?FARE[LINES[l.line].type]:l.kind==='bike'?FARE.bike:0),0);
  const rideTypes=new Set(legs.filter(l=>l.kind==='ride').map(l=>LINES[l.line].type));
  if(rideTypes.size>1)fare*=.8; /* تخفیف بلیت ترکیبی */
  return {legs,total,fare,fromId,toId};
}

/* ================= ترسیم شماتیک مسیر ================= */
function catmull(pts){
  let d=`M ${pts[0][0]} ${pts[0][1]}`;
  for(let i=0;i<pts.length-1;i++){
    const p0=pts[Math.max(0,i-1)],p1=pts[i],p2=pts[i+1],p3=pts[Math.min(pts.length-1,i+2)];
    d+=` C ${(p1[0]+(p2[0]-p0[0])/6).toFixed(1)} ${(p1[1]+(p2[1]-p0[1])/6).toFixed(1)}, ${(p2[0]-(p3[0]-p1[0])/6).toFixed(1)} ${(p2[1]-(p3[1]-p1[1])/6).toFixed(1)}, ${p2[0]} ${p2[1]}`;
  }
  return d;
}
function routeSVG(line,oIdx,dIdx){
  const sids=line.stops.slice(oIdx,dIdx+1),n=sids.length;
  const xs=[66,262,112,240,74,252,96,268,62,236];
  const pts=sids.map((s,i)=>[i===0?70:i===n-1?258:xs[i%xs.length],92+i*88]);
  const W=340,H=92+(n-1)*88+104,col=line.color,d=catmull(pts);
  const dots=sids.map((sid,i)=>{
    const[x,y]=pts[i],st=ST[sid],isO=i===0,isD=i===n-1;
    let g=`<g class="st" style="animation-delay:${(.15+i*.09).toFixed(2)}s">`;
    if(isO)g+=`<circle class="pc" cx="${x}" cy="${y}" r="10" fill="${col}" stroke="var(--bg)" stroke-width="4"/><circle cx="${x}" cy="${y}" r="3.4" fill="#fff"/>`;
    else if(isD)g+=`<circle class="pc spinr" cx="${x}" cy="${y}" r="16" fill="none" stroke="${col}" stroke-width="2.4" stroke-dasharray="4 6"/><circle class="pc" cx="${x}" cy="${y}" r="8.5" fill="var(--bg)" stroke="${col}" stroke-width="4"/><circle cx="${x}" cy="${y}" r="2.6" fill="${col}"/>`;
    else{g+=`<circle class="pc" cx="${x}" cy="${y}" r="6.5" fill="var(--bg)" stroke="${col}" stroke-width="3.5"/>`;}
    const rt=x<170;
    g+=`<text class="rl" x="${x+(rt?17:-17)}" y="${y+4}" text-anchor="${rt?'start':'end'}">
      <tspan x="${x+(rt?17:-17)}" dy="0">${st.n}</tspan>
      <tspan class="rl-c" x="${x+(rt?17:-17)}" dy="15">کد ${fa(st.c)}</tspan></text>`;
    g+=`<circle class="hit" cx="${x}" cy="${y}" r="21" fill="transparent" data-sid="${sid}"/></g>`;
    return g;}).join('');
  const chip=(x,y,t)=>`<g class="fi"><rect x="${x-26}" y="${y-13}" width="52" height="24" rx="9" fill="var(--bg)" stroke="#c8ccd1" stroke-width="1.2"/><text x="${x}" y="${y+5}" text-anchor="middle" font-size="11" font-weight="800" fill="var(--acc)">${t}</text></g>`;
  return `<svg id="rsvg" class="route-svg" dir="ltr" viewBox="0 0 ${W} ${H}" data-n="${n}">
    <path class="rp-bg fi" d="${d}"/><path class="rp draw" d="${d}" style="stroke:${col}"/>
    <path class="rp-dash fi" d="${d}"/>
    ${chip(pts[0][0],pts[0][1]-34,'مبدا')}${chip(pts[n-1][0],pts[n-1][1]+40,'مقصد')}
    ${dots}
    <g id="busM"><circle r="11" fill="#fff" stroke="${col}" stroke-width="4"/><circle r="3" fill="${col}"/></g>
  </svg>`;
}

