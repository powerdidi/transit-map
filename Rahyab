const LINES={
 BRT1:{id:'BRT1',type:'brt',num:'1',title:'BRT خط ۱',color:'#c14f4b',hw:7,from:'بلوار وکیل‌آباد',to:'حرم مطهر',stops:['vakilabad','parkemellat','ghasemabad','haram']},
